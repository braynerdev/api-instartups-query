{
  "ConnectionStrings": {
    "PostgresConnection": "Host=EXEMPLO;Port=EXEMPLO;Database=EXEMPLO;Username=EXEMPLO;Password=EXEMPLO"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Wolverine": "Warning",
        "Instartups.Query.Api.Configurations": "Information",
        "Instartups.Query.Infrastructure.Configurations": "Information",
        "Instartups.Query.Application.Configurations": "Information",
        "Instartups.Query.Domain.Configurations": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      { "Name": "Debug" }
    ],
    "Properties": {
      "Application": "NOME APP"
    }
  },
  "JWT": {
    "PublicKeyPath": "",
    "Issuer": "",
    "Audience": ""
  },
  "CorsPadrao": ["https://IP:PORT"],
  "AllowedHosts": "*"
}
