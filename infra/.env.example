# Copie para .env e preencha: cp .env.example .env

# Aplicação
IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8082
TZ=America/Sao_Paulo

# Banco (o mesmo da api-instartups-command). Para o Postgres da própria máquina use host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=instartups_db
DB_USER=postgres
DB_PASSWORD=
DB_MIN_POOL_SIZE=0
DB_MAX_POOL_SIZE=50

# JWT (mesmos valores da api-instartups-auth)
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=
JWT_AUDIENCE=

# CORS (origem do frontend)
CORS_ORIGIN=

# Limites do container
API_CPUS=1.0
API_MEMORY=512M
